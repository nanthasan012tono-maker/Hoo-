--==================================================
-- TAB BUTTON
--==================================================
local function createTabButton(text, tab)
    local button = Instance.new("TextButton")
    button.Size = UDim2.fromOffset(60, 40)
    button.BackgroundColor3 = defaultTabColor
    button.BackgroundTransparency = 0.3
    button.Text = text
    button.TextColor3 = Color3.new(1, 1, 1)
    button.TextScaled = true
    button.Font = Enum.Font.GothamBold
    button.AutoLocalize = false
    button.Parent = tabBar

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = button

    button.MouseButton1Click:Connect(function()
        for _, frame in pairs(tabs) do frame.Visible = false end
        for _, btn in pairs(tabButtons) do
            btn.BackgroundColor3 = defaultTabColor
            btn.BackgroundTransparency = 0.3
        end
        tab.Visible = true
        button.BackgroundColor3 = activeTabColor
        button.BackgroundTransparency = 0
    end)

    table.insert(tabButtons, button)
    return button
end

